# Normalize repository text to LF regardless of contributor OS.
* text=auto eol=lf

# Windows launchers keep their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Explicit binary assets.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.zip binary
*.gz binary
