{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdular",
  "mainBinaryName": "mdular",
  "version": "../app.manifest.json",
  "identifier": "com.issuegame.mdular",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mdular",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A modular, local-first Markdown editor.",
    "longDescription": "A modular, local-first Markdown editor.",
    "copyright": "Copyright © CalebCao9420",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRkFDMTQxRjJEMkREMjgKUldRbzNkTHlRY0g2a3VUUWdXbldKNmY0aFpQY0JVM25XOHdBYlh2Q1FaYVp3SXNSZkozTmxxY2YK",
      "endpoints": [
        "https://github.com/CalebCao9420/mdular/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
