{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Main application window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "shell:default",
    "allow-runtime-mode",
    "allow-workspace-io",
    "allow-updater-coordination"
  ]
}
